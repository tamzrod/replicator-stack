                              |value=integer
                              |level=[high|medium|low]
                              |basis=[statistical|expert|heuristic]
                              |factors=[string]
                              |context=Context
                              |boundary=Boundary_or_null
                              |assumptions=[Assumption]
                              |verified=boolean
                              |verification_count=integer
                              |engine_id=string
                              |engine_version=string
                              |created=ISO8601
                              |status=[draft|validated|approved|published]
