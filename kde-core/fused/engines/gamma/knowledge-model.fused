                  ||['intervention.side_effects', 'Array', 'No', 'Known side effects']
                |evidence_fields
                  |table
                    ||['Field', 'Type', 'Required', 'Description']
                    ||['evidence.supporting', 'Array', 'Yes', 'Supporting evidence']
